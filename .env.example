NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No service-role key belongs in this application.

# Server-only. Never prefix this credential with NEXT_PUBLIC_.
ADBLUE_OPENAI_API_KEY=
# Choose an OpenAI model that supports image input and strict JSON schema.
# No default model is assumed; set this explicitly before using real OCR.
OPENAI_OCR_MODEL=
# Optional: permit OCR only in local development without Supabase Auth.
# Disabled unless explicitly true; production never permits this bypass.
ADBLUE_ALLOW_LOCAL_OCR=false
